{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "open-bi-back/users/repository/user.js": ["ports/repository/user.d.ts"],
      "open-bi-back/users/repository/user.repository.js": ["ports/repository/user.repository.d.ts"],
      "open-bi-back/users/repository/user.schema.js": ["ports/repository/user.schema.d.ts"]
    }
  },
  "include": ["src"]
}
